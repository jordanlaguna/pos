	"invoices_previous": "Previous",
	"invoices_next": "Next",
	"invoices_page_of": "Page {page} of {total}",

	"invoice_tab_title": "Invoice {number}",
	"invoice_not_found": "Invoice not found.",
	"invoice_registered": "Sale recorded successfully.",
	"invoice_print": "Print",
	"invoice_back": "Back to invoices",
	"invoice_return": "Return",
	"invoice_backend_pdf": "Backend PDF",
	"invoice_fully_returned": "Sale returned in full",
	"invoice_partially_returned": "Sale with partial returns",
	"invoice_return_line": "{date} — {total} · {reason}",

