# Copiá este archivo como `.env` y ajustá los valores.

# ----------------------------------------------------------------- backend
# URL del FastAPI.
#
# Con el docker-compose, FastAPI escucha en el puerto 80 DENTRO del contenedor y
# se publica en el 8001 de la VM (la línea "8001:80"). El puerto es 8001, no 8000.
# Desde otra máquina va la IP de la VM, no localhost.
API_BASE_URL=http://192.168.1.50:8001

# 1 = backend simulado con datos de ejemplo (no toca la red).
# 0 = se usa API_BASE_URL.
POS_MOCK=0

# Corte por petición. Un backend colgado no debe congelar la caja.
API_TIMEOUT_MS=8000

# Stock por debajo del cual el dashboard alerta.
LOW_STOCK_THRESHOLD=10

# ------------------------------------------------- solo build de producción
# Estas dos las usa `node build/index.js`; en `npm run dev` no hacen falta.
#
# ORIGIN es la URL pública del POS. adapter-node la exige para validar los
# formularios: sin ella, TODO POST responde 403 «Cross-site POST form
# submissions are forbidden» y no se puede ni iniciar sesión ni cobrar.
# Tiene que coincidir con la dirección por la que entran los cajeros.
ORIGIN=http://192.168.1.60:3000
PORT=3000

# Poné 1 solo si servís el POS por HTTP en producción (cookie sin flag secure).
# Con HTTPS, dejalo comentado.
# POS_INSECURE_COOKIE=1
