{
  "_meta": {
    "titulo": "Ejemplos de payloads - Protocolos especiales CR (v4.4)",
    "importante_para_QA": "NO se agrego ningun campo nuevo al canonico. Todos los protocolos usan campos ya existentes: 'otros[]' y 'references[]'. El contrato del API es identico al anterior.",
    "campos_usados": {
      "otros[]": "element (OtroTexto|OtroContenido), code (atributo codigo, opcional), text",
      "references[]": "referenceType, referenceTypeOther?, referenceId, referenceDate, reasonCode, reasonCodeOther?, reason"
    },
    "como_probar": [
      "POST http://<host>/api/documents con headers: Authorization: Bearer <apiKey>, X-Issuer-Id: <issuerId>, Content-Type: application/json.",
      "officialId.consecutive DEBE ser unico por envio (si se repite, Hacienda responde -99).",
      "issueDate DEBE ser la hora actual de Costa Rica (offset -06:00).",
      "receiver y el issuer autenticado deben ser entidades reales registradas ante Hacienda para lograr ACEPTADO.",
      "Consultar el estado con GET /api/documents/{id} hasta Accepted/Rejected (flujo asincrono)."
    ],
    "forma_NO_soportada": "Complemento anidado retail:Complemento dentro de <OtroContenido> (Gessa 003 / PriceSmart 005/105). Hacienda lo RECHAZA con -1 (cvc-complex-type.2.2: OtroContenido no admite elementos hijos). Debe entregarse al retailer fuera de banda, no embebido en el comprobante fiscal."
  },
