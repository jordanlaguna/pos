# Copiá este archivo como `.env` en la misma carpeta que el docker-compose.yml.
# Compose lo carga solo. El `.env` NO se versiona; este ejemplo sí.
#
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   # → SECRET_KEY

# ------------------------------------------------------------- zona horaria
# La del negocio. Los contenedores Docker arrancan en UTC si no se les dice
# nada, y el backend sella ventas, turnos de caja y devoluciones con la hora del
# sistema: con seis horas de desfase, una venta de las 19:00 se guarda como del
# día siguiente y el arqueo del turno de noche queda partido en dos.
TZ=America/Costa_Rica

# ---------------------------------------------------------------- base de datos
DB_NAME=posdb
DB_USER=posuser
DB_PASS=cambiá_esta_contraseña
MYSQL_ROOT_PASSWORD=cambiá_esta_también

# ------------------------------------------------------------------- seguridad
# Firma los JWT. Sin ella el backend usa "clave_por_defecto_insegura", que está
# publicada en el repositorio: cualquiera podría firmarse un token de
# administrador. Generala con el comando de arriba y no la compartas.
SECRET_KEY=

# Minutos de vigencia del token. 480 = 8 horas, un turno completo de caja.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ----------------------------------------------------------------------- red
# Puerto de la VM donde queda expuesto FastAPI. El POS apunta acá:
#   API_BASE_URL=http://IP_DE_LA_VM:8001
API_PORT=8001

# Orígenes permitidos por CORS, separados por comas. Vacío = CORS deshabilitado.
# El POS llama desde su servidor, no desde el navegador, así que suele ir vacío.
ALLOWED_ORIGINS=

# ------------------------------------------------------- factura electrónica
# Cifra la contraseña de ATV en reposo. 32 bytes en base64url:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# El backend NO arranca si falta o si no mide eso. Es a propósito: el otro
# momento posible para enterarse es el día que alguien guarda credenciales.
#
# Y hay que guardarla aparte del respaldo de la base. Con la llave perdida, lo
# cifrado no vuelve — hay que volver a escribir la contraseña de ATV a mano.
FE_CRYPTO_KEY=

# Almacén de comprobantes (MinIO). El usuario y la contraseña son los del
# contenedor y los usa también la API. Mínimo 8 caracteres en la contraseña o
# MinIO se niega a arrancar.
MINIO_ROOT_USER=ventasys
MINIO_ROOT_PASSWORD=cambiá_esta_también

# Estos dos solo se tocan si el almacén no es el del compose —S3, R2, un MinIO
# en otra máquina—. El bucket se crea solo si no existe.
FE_STORAGE_ENDPOINT=http://minio:9000
FE_STORAGE_BUCKET=ventasys-fe

# Vault, donde vive la llave de firma. El token se saca al inicializarlo la
# primera vez (README, «Abrir Vault al arrancar»); hasta entonces va vacío y lo
# único que no funciona es firmar.
FE_VAULT_ADDR=http://vault:8200
FE_VAULT_TOKEN=
