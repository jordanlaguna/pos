# Credenciales del backend: contraseñas de la base y clave de firma de los JWT.
backend/.env

# Dumps que se cargan al inicializar la base; suelen traer datos reales.
backend/initdb/*.sql
!backend/initdb/.gitkeep

# Variables del POS (incluye la IP de la VM).
frontend/.env
# Base del modo mock: datos de prueba que se regeneran solos.
frontend/.data/

# Despliegue viejo, en desuso: tiene el .env real y una copia del backend.
deploy/

node_modules/
__pycache__/
*.py[cod]

# Compilados
frontend/.svelte-kit/
frontend/build/

# Salida de las pruebas. Se regenera en cada corrida.
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
.pytest_cache/
.coverage
htmlcov/

# Permisos de esta máquina. `.claude/settings.json` sí se versiona —es el
# acuerdo del proyecto— pero el `.local` lleva rutas del scratchpad y permisos
# que concedió quien está sentado acá, y no le sirven a nadie más.
.claude/settings.local.json
